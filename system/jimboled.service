[Unit]
Description=JimboLED – WLED and GPIO dashboard
Documentation=https://github.com/SethMorrowSoftware/JimboLED
After=network-online.target
Wants=network-online.target
# Never give up on a crash loop: this is a headless appliance.
StartLimitIntervalSec=0

[Service]
Type=exec
User=__USER__
Group=__USER__
__SUPP_GROUPS__
StateDirectory=jimboled
StateDirectoryMode=0750
# lgpio creates a notification pipe in its working directory at import time.
RuntimeDirectory=jimboled
WorkingDirectory=__DATA__
Environment=PYTHONPATH=__APP__
Environment=JIMBOLED_DATA_DIR=__DATA__
Environment=JIMBOLED_HELPER=__APP__/bin/jimboled-helper
Environment=JIMBOLED_INSTALL_ENV=/etc/jimboled/install.env
Environment=LG_WD=/run/jimboled
Environment=PYTHONUNBUFFERED=1
Environment=GPIOZERO_PIN_FACTORY=__PIN_FACTORY__
# Optional overrides (JIMBOLED_THREADS, GPIOZERO_PIN_FACTORY=mock, ...)
EnvironmentFile=-/etc/jimboled/jimboled.env
ExecStart=__VENV__/bin/python -m jimboled
# Belt and braces: after the process is gone (even SIGKILL), drive every relay pin to its OFF level.
ExecStopPost=+__APP__/bin/jimboled-helper pins-safe
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
SyslogIdentifier=jimboled
# Bind port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# Light sandbox. Do NOT add NoNewPrivileges/PrivateDevices/ProtectSystem=strict:
# the sudo helper and /dev/gpiochip0 need them off.
ProtectHome=yes
PrivateTmp=yes
UMask=0027

[Install]
WantedBy=multi-user.target
